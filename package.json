    "@capacitor/cli": "^8.6.2",
    "typescript": "^5.6.0",
    "xcode": "^3.0.1"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  }
}
